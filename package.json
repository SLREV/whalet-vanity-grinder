{
  "name": "solana-vanity-grinder",
  "version": "1.0.0",
  "private": true,
  "description": "Generator vanity address Solana (prefix nama sendiri) - mengikuti format keypair resmi solana-keygen",
  "bin": {
    "solana-vanity": "./bin/grind.js"
  },
  "scripts": {
    "grind": "node bin/grind.js",
    "test": "node test.mjs",
    "test:app": "node tools/test-app-core.mjs",
    "test:e2e": "node test-e2e.mjs",
    "test:all": "node test.mjs && node tools/test-app-core.mjs && node test-e2e.mjs",
    "build:app": "node tools/build-app.mjs && node tools/make-icons.mjs",
    "android:sync": "npm run build:app && npx cap sync android",
    "android:debug": "npm run android:sync && cd android && ./gradlew assembleDebug",
    "preview:app": "npm run build:app && node tools/serve-app.mjs",
    "fixtures": "node tools/make-fixtures.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.3",
    "@capacitor/android": "^8.5.3",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/share": "^8.0.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "bs58": "^6.0.0",
    "tweetnacl": "^1.0.3"
  },
  "overrides": {
    "uuid": "11.1.1"
  }
}
